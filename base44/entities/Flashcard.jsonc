{
  "name": "Flashcard",
  "type": "object",
  "properties": {
    "note_id": {
      "type": "string"
    },
    "front": {
      "type": "string"
    },
    "back": {
      "type": "string"
    },
    "subject": {
      "type": "string"
    },
    "difficulty": {
      "type": "string",
      "enum": [
        "easy",
        "medium",
        "hard"
      ],
      "default": "medium"
    },
    "reviewed": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "front",
    "back"
  ]
}
